{
  "name": "tvdeck",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tvdeck/server",
    "build": "npm run build -w @tvdeck/remote && npm run build -w @tvdeck/launcher",
    "start": "npm run start -w @tvdeck/server --",
    "icons": "node scripts/gen-icons.mjs",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/autostart-install.ps1",
    "autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/autostart-remove.ps1",
    "test": "vitest run",
    "typecheck": "tsc -p packages/protocol && tsc -p packages/server && tsc -p packages/remote && tsc -p packages/launcher",
    "spike:input": "npm run spike:input -w @tvdeck/server",
    "spike:home": "npm run spike:home -w @tvdeck/server",
    "spike:m4": "npm run spike:m4 -w @tvdeck/server",
    "remote:probe": "npm run remote:probe -w @tvdeck/server",
    "devices": "npm run devices -w @tvdeck/server --",
    "dev:headless": "npm run dev:headless -w @tvdeck/server",
    "app:build": "node scripts/build-app.mjs",
    "app:install": "npm run app:build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/app-install.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
